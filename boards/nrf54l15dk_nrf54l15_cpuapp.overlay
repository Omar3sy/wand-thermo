#include <samples/matter/nrf54l15_cpuapp_partitions.dtsi>

/ {
	aliases {
		/* Use watchdog wdt31 as the application watchdog */
		watchdog0 = &wdt31;
	};

	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};
};

&mx25r64 {
	status = "okay";
};

&wdt31 {
	status = "okay";
};

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 11)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	scd41: scd41@62 {
		compatible = "i2c-device";
		reg = <0x62>;
	};
};

/* Custom pinctrl for spi22, NOT the board's spi22_default: that one puts
 * SCK on P1.11, which collides with i2c21's SDA (SCD41) above. SPIM pin
 * mux on the nRF54L is freely assignable, so SCK/MOSI are moved to
 * previously-unused pins instead. Write-only (display breakout only has
 * BUSY/RST/DC/CS/CLK/DIN/GND/VCC - confirmed no SDO/MISO pin exists on
 * this board at all), so MISO is left unconfigured. */
&pinctrl {
	spi22_eink_default: spi22_eink_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 12)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>;
		};
	};

	spi22_eink_sleep: spi22_eink_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 12)>,
				<NRF_PSEL(SPIM_MOSI, 1, 6)>;
			low-power-enable;
		};
	};
};

/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <900>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};
};

/* Console/shell stays on UART20 (P1.04-P1.07), no override needed. */

/* LED1 (P1.10) and LED3 (P1.14) are sacrificed for the LCD RS and D7 lines. */
/delete-node/ &led1;
/delete-node/ &led3;

/* PWM20 also drives P1.10 (PWM_OUT0) - disable it and its LED so RS is free. */
/delete-node/ &pwm_led1;

&pwm20 {
	status = "disabled";
};

/ {
	aliases {
		/delete-property/ led1;
		/delete-property/ led3;
		/delete-property/ pwm-led0;
	};

};

/* E-Paper (Microtech MTE0154A03B-V1) on the free spi22 instance, routed to
 * the expansion header. This is real hardware SPI, not bitbanged - zephyr's
 * spi-gpio driver doesn't exist in this NCS version (checked), and spi22 is
 * exactly the instance Nordic's own board dtsi reserves for this purpose
 * ("nordic_expansion_spi"). cs-gpios' default (P1.10) is kept; DC/RESET/BUSY
 * are plain GPIOs on previously-unused pins.
 *
 * Note from Nordic's board dtsi: spi22 is documented there as conflicting
 * with UART30 - our console is UART20, not UART30, and RTS on UART20
 * happens to share this SPI's MOSI pin (P1.06). Unused as long as UART20
 * hardware flow control stays off (the default); verify on the real board
 * if the console misbehaves after this change.
 *
 * pinctrl-0/1 overridden below (spi22_eink_default/sleep), NOT the board's
 * own spi22_default/sleep - those put SCK on P1.11, which is the SCD41's
 * I2C SDA pin (see &i2c21 above). */
&spi22 {
	status = "okay";
	pinctrl-0 = <&spi22_eink_default>;
	pinctrl-1 = <&spi22_eink_sleep>;
	pinctrl-names = "default", "sleep";

	eink_display: eink@0 {
		compatible = "microtech,eink154";
		reg = <0>;
		spi-max-frequency = <1000000>;
		dc-gpios = <&gpio2 6 GPIO_ACTIVE_HIGH>;     /* was D4 */
		reset-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;   /* was D5 */
		busy-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;  /* was D6 */
		width = <200>;
		height = <200>;
	};
};
